#!/bin/bash
# Logs to /tmp/kami.log. Appended to, unlike Pepper's: a second `kami`
# hands its files to the running one and exits, and truncating the log on
# the way would cut the running Kami's log out from under it. After a
# failed run:
#   tail -n 200 /tmp/kami.log
#
# Resolves the checkout from this script's own location, so ~/bin/kami can
# be a symlink into any checkout (desktop/install.sh makes one).
#
# Pins /usr/bin/python3: PySide6 comes from Fedora's python3-pyside6 RPM,
# which is built for the system interpreter. A different python3 earlier on
# PATH, such as an activated venv, wouldn't have it.
ROOT="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
exec env PYTHONPATH="$ROOT" \
    nohup /usr/bin/python3 -m kami.main "$@" >>/tmp/kami.log 2>&1 &
